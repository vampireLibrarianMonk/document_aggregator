# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Environment ----
.env

# ---- Runtime data (immutable originals, indexes, canonical docs) ----
data/
# local dev throwaway store (API/worker DATA_DIR for local runs)
.local_data/

# ---- Node / frontend ----
node_modules/
frontend/dist/
frontend/node_modules/

# ---- OS / editor ----
.DS_Store
Thumbs.db
*.log

# scenario-generation model eval reports (dev artifacts)
backend/eval_models_report.json
backend/eval_models_report_*.json
backend/eval_governor_report.json
backend/eval_governor_report_*.json
backend/eval_authoring_report.json
backend/eval_authoring_report_*.json
backend/eval_adversarial_report.json
backend/eval_adversarial_report_*.json

# TypeScript incremental build cache
*.tsbuildinfo

# ---- Bake-off model-response cache (runtime; re-created on demand) ----
backend/tests/command_center/_model_cache/

# ---- Model-sweep results (generated on demand; a full cross-model run only) ----
backend/tests/command_center/model_sweep_results.json

# ---- Tool-use spiral results + sweep run log (generated on demand) ----
backend/tests/command_center/tooluse_spiral_results.json
backend/tests/command_center/_sweep_run.log

# ---- MaDI-Bench external benchmark data (NEVER committed) ----
# MaDI-Bench carries no license; its data is obtained by the developer
# separately (public download) and lives outside the repo. Guard against any
# accidental in-repo copy.
madi_bench_data/
**/MaDI-Bench/

# ---- Agent / workflow scratch output (regenerated per run; not source) ----
.agents/
**/.agents/
semantic-review/
new_spec/

# ---- Kiro session operation logs (tooling-generated; not source) ----
.kiro/operations-*
# Dated session logs (same tooling-generated kind, bare-date filename).
.kiro/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]

# Generated SBOM artifact (reproducible on request; manual SBOM.md is committed)
sbom.cdx.json
