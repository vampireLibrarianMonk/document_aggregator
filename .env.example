# =============================================================================
# Document Aggregation Platform — Environment template
# Copy to .env and adjust as needed:  cp .env.example .env
# =============================================================================

APP_ENV=development
DATA_DIR=./data

# OCR applies to scanned/flattened PDFs and images. The Docker images ship the
# pytesseract + PyMuPDF wheels AND the system `tesseract` binary, so OCR is ON
# by default. If you run outside Docker without tesseract installed, OCR simply
# reports unavailable and scanned docs degrade to "needs_ocr" (no hard failure).
OCR_ENABLED=true
OCR_LANG=eng
OCR_MAX_PAGES=20
VISION_ENABLED=false
LLM_ENABLED=false
EMBEDDINGS_ENABLED=true

# In-app sample-case instantiation. OFF by default: the bundled sample cases
# are meant to be run from the repo per the user guide. Set to true to expose a
# separate 'Samples' tab in the UI that instantiates a bundled case on click.
SAMPLES_ENABLED=false
# In-app Diagnostics page (/diagnostics). OFF by default. Set to true to expose
# the live service-status page (embeddings, OCR, LibreOffice, Bedrock).
DIAGNOSTICS_ENABLED=false

# EMBEDDING_BACKEND: auto | sentence-transformers | hashing. The Docker images
# bake the all-MiniLM-L6-v2 weights, so sentence-transformers runs fully offline
# for real semantic search. 'auto' also resolves to it when installed; 'hashing'
# forces the deterministic fallback (weak on meaning).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_ST_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL=local-hashing-embedder
EMBEDDING_REVISION=v1
EMBEDDING_DIM=256

OPENSEARCH_HOST=
SEARCH_BACKEND=auto

MAX_UPLOAD_MB=50

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

VITE_API_BASE=http://localhost:8000
