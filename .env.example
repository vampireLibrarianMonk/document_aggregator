# =============================================================================
# Document Aggregation Platform — Environment template
# Copy to .env and adjust as needed:  cp .env.example .env
# =============================================================================

APP_ENV=development
DATA_DIR=./data

# OCR applies to scanned/flattened PDFs and images. The Docker images ship the
# pytesseract + PyMuPDF wheels AND the system `tesseract` binary, so OCR is ON
# by default. If you run outside Docker without tesseract installed, OCR simply
# reports unavailable and scanned docs degrade to "needs_ocr" (no hard failure).
OCR_ENABLED=true
OCR_LANG=eng
OCR_MAX_PAGES=20
VISION_ENABLED=false
LLM_ENABLED=false
EMBEDDINGS_ENABLED=true

# In-app Diagnostics page (/diagnostics). OFF by default. Set to true to expose
# the live service-status page (embeddings, OCR, LibreOffice, Bedrock).
DIAGNOSTICS_ENABLED=false

# EMBEDDING_BACKEND: auto | sentence-transformers | hashing. The Docker images
# bake the all-MiniLM-L6-v2 weights, so sentence-transformers runs fully offline
# for real semantic search. 'auto' also resolves to it when installed; 'hashing'
# forces the deterministic fallback (weak on meaning).
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_ST_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL=local-hashing-embedder
EMBEDDING_REVISION=v1
EMBEDDING_DIM=256

OPENSEARCH_HOST=
SEARCH_BACKEND=auto

MAX_UPLOAD_MB=50

# =============================================================================
# Bedrock — OPTIONAL model tier (off by default)
# =============================================================================
# The correction coordinator and the project-generation governor ALWAYS run.
# They do NOT require Bedrock: offline they use the deterministic engine
# (RuleProjectGenerator + the grounded reconcile), which is the authoritative
# floor. Bedrock is an optional REFINEMENT tier on top — it sharpens the
# natural-language steps (reviewer-feedback parsing, ambiguous conflicts) but
# never writes final state, and every value it proposes passes a grounding gate
# before the deterministic engine accepts it. In the bake-off it lifted value
# accuracy 95.0 -> 96.6% and status 74.4 -> 76.1% (a refinement, not a
# transformation; see docs/testing/bakeoff-command-center.md).
#
# WHY OFF BY DEFAULT: the open-source default is offline-first — reproducible
# (byte-identical re-runs) and air-gap-safe (no outbound calls). Turning it on
# trades those for the refinement above.
#
# AIR-GAPPED ENCLAVE WITH BEDROCK: set BEDROCK_ENABLED=true. The enclave's
# Bedrock endpoint is reached with the same offline posture (HF/Transformers
# guards stay on; only Bedrock calls go out, to the in-enclave service).
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
# BEDROCK_MODEL drives the TOOL-USE tiers (feedback interpreter + JSON semantic
# alignment). BEDROCK_SCENARIO_MODEL drives project GENERATION and is enforced
# against the allowlist. Both default to an allowlisted gpt-oss id so enabling
# Bedrock is coherent with no extra config. Leave blank to use that default.
BEDROCK_MODEL=
BEDROCK_SCENARIO_MODEL=
# Only models whose id matches one of these comma-separated family substrings
# are approved for generation. Add a family here if your enclave approves it
# (e.g. append ",claude" only if Claude is genuinely approved in your enclave).
BEDROCK_SCENARIO_MODEL_ALLOWLIST=nemotron,gpt-oss
# Where the host AWS config/credentials live, mounted read-only into the api +
# worker containers so boto3 resolves the SAME creds as the host. Harmless when
# absent (boto3 finds nothing -> offline). On Windows this is %USERPROFILE%\.aws.
# AWS_DIR=/home/you/.aws

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

VITE_API_BASE=http://localhost:8000
