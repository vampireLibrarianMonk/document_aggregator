# =============================================================================
# Document Aggregation Platform — Environment template
# Copy to .env and adjust as needed:  cp .env.example .env
# =============================================================================

APP_ENV=development
DATA_DIR=./data

OCR_ENABLED=false
# OCR applies to scanned/flattened PDFs and images. Requires the pytesseract +
# PyMuPDF wheels (see backend/requirements-api.txt) AND a system `tesseract`
# binary. When off or no engine is installed, scanned docs report "needs_ocr".
OCR_LANG=eng
OCR_MAX_PAGES=20
VISION_ENABLED=false
LLM_ENABLED=false
EMBEDDINGS_ENABLED=true

EMBEDDING_BACKEND=auto
EMBEDDING_ST_MODEL=all-MiniLM-L6-v2
EMBEDDING_MODEL=local-hashing-embedder
EMBEDDING_REVISION=v1
EMBEDDING_DIM=256

OPENSEARCH_HOST=
SEARCH_BACKEND=auto

MAX_UPLOAD_MB=50

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

VITE_API_BASE=http://localhost:8000
