# WORKER service — LOCAL image (Debian base) with FULL capability installed.
#
# Local/developer counterpart to deploy/docker/Dockerfile.rhel (UBI). Same full
# stack as the local api image (OCR + LibreOffice + baked MiniLM), running the
# templated worker loop against the shared job queue. The enclave deployment
# uses the UBI worker image.

FROM python:3.12-slim-bookworm

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        tesseract-ocr \
        libreoffice-writer libreoffice-calc \
        fonts-liberation fonts-crosextra-carlito fonts-crosextra-caladea \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY backend/requirements-api.txt /app/backend/requirements-api.txt
COPY backend/requirements-worker.txt /app/backend/requirements-worker.txt
RUN pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch \
    && pip install --no-cache-dir -r /app/backend/requirements-worker.txt

ENV HF_HOME=/opt/hf-cache \
    SENTENCE_TRANSFORMERS_HOME=/opt/hf-cache
ARG EMBEDDING_ST_MODEL=all-MiniLM-L6-v2
RUN python -c "from sentence_transformers import SentenceTransformer; \
SentenceTransformer('${EMBEDDING_ST_MODEL}')" \
    && echo "[build] baked ${EMBEDDING_ST_MODEL} into ${HF_HOME}"

COPY backend /app/backend
COPY sample_docs /app/sample_docs

ENV APP_ENV=production \
    DATA_DIR=/data \
    EMBEDDING_BACKEND=sentence-transformers \
    EMBEDDINGS_ENABLED=true \
    OCR_ENABLED=true \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    BEDROCK_ENABLED=false \
    WORKER_CONCURRENCY=2

RUN mkdir -p /data
CMD ["python", "backend/worker_main.py"]
